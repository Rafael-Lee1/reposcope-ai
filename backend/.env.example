# RepoScope AI — backend environment variables.
#
# Copy this file to `.env` and adjust for your environment.
# The real `.env` file is git-ignored and must never be committed.
#
# No secrets are required: RepoScope AI analyzes public repositories only.

# Browser origins allowed to call the API, comma-separated.
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
#
# Local development:
ALLOWED_ORIGINS=http://localhost:5173
#
# Multiple origins (e.g. a deployed frontend):
# ALLOWED_ORIGINS=https://reposcope-ai.example.com,http://localhost:5173
